# Telegram BotFather'dan olingan token
BOT_TOKEN=123456789:AAExampleTokenHere

# Mini App (frontend) manzili — BotFather'da /newapp orqali sozlangan bo'lishi kerak
WEBAPP_URL=https://your-mini-app.example.com

# Backend (FastAPI) manzili
API_BASE_URL=https://your-backend.example.com
# Bot <-> backend orasidagi ichki so'rovlarni tasdiqlash uchun maxfiy kalit
# (o'zi ixtiyoriy uzun tasodifiy satr yaratib qo'ying)
API_INTERNAL_SECRET=change-me-to-a-long-random-string

# Webhook (Railway kabi production muhitda tavsiya etiladi)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://your-bot.example.com
WEBHOOK_SECRET=change-me-too
PORT=8080

# Vergul bilan ajratilgan Telegram ID'lar ro'yxati (admin komandalar uchun)
ADMIN_IDS=111111111,222222222

# Yordam bo'limidagi administrator username (@ belgisisiz)
SUPPORT_USERNAME=your_support_username

# Referal bonusi (Stars birligida). 0 bo'lsa referal bonusi ko'rsatilmaydi.
REFERRAL_BONUS_STARS=0
